# Generated MEX package contents
elara-toolbox/+elara/+mex/**

# Exclude directory placeholders
!elara-toolbox/+elara/+mex/.gitkeep

# Autosave files
*.asv
*.m~
*.autosave
*.slx.r*
*.mdl.r*
*.bak

# Derived content-obscured files
*.p

# Compiled MEX files
*.mex*

# Packaged app and toolbox files
*.mlappinstall
*.mltbx

# Deployable archives
*.ctf

# Generated helpsearch folders
helpsearch*/

# MathJax extensions, which are downloaded when the HTML docs are generated
elara-toolbox/doc/resources/input/**

# Code generation folders
slprj/
sccprj/
codegen/

# Cache files
*.slxc

# Cloud based storage dotfile
.MATLABDriveTag
